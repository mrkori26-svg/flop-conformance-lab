    "mailbox_validity": {
      "unit": "ratio",
      "numerator": "mailbox objects passing structure, identity and signature checks",
      "denominator": "mailbox objects inspected",
      "semantics": "No denominator means no mailbox claim; absence of observations is not success."
    },
