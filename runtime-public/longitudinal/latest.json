  "metricDefinitions": {
    "runtime_availability": {
      "unit": "ratio",
      "numerator": "successful target observations",
      "denominator": "scheduled target observations",
      "semantics": "Observer failures are not target failures; indeterminate observations remain UNKNOWN."
    },
    "interaction_success": {
      "unit": "ratio",
      "numerator": "eligible interaction surfaces inspected successfully",
      "denominator": "eligible interaction surfaces attempted",
      "semantics": "Measures observation success, not social approval or adoption."
    },
    "signature_verification": {
      "unit": "ratio",
      "numerator": "cryptographically verified signed objects",
      "denominator": "signed or signature-relevant objects observed",
      "semantics": "INVALID, UNVERIFIED, NOT_PRESENT and SIGNER_UNAVAILABLE remain distinct."
    },
    "room_retention": {
      "unit": "ratio",
      "numerator": "rooms with complete retained coverage",
      "denominator": "rooms inspected",
      "semantics": "Generation reset, retention gap, partial window and unknown window are not counted as complete."
    },
    "mailbox_validity": {
      "unit": "ratio",
      "numerator": "mailbox objects passing structure, identity and signature checks",
      "denominator": "mailbox objects inspected",
      "semantics": "No denominator means no mailbox claim; absence of observations is not success."
    },
    "tclk_parse_rate": {
      "unit": "ratio",
      "numerator": "TCLK frames parsed under the pinned parser revision",
      "denominator": "TCLK frames presented",
      "semantics": "Parser exceptions and malformed frames are failures; unavailable inputs are UNKNOWN."
    },
    "conformance_drift": {
      "unit": "ratio",
      "numerator": "sources unchanged or conformant",
      "denominator": "sources compared",
      "semantics": "DRIFT is distinct from FAIL and UNKNOWN and retains source revision evidence."
    },
    "failure_classifications": {
      "unit": "classification",
      "numerator": "classified failure observations",
      "denominator": "failure observations",
      "semantics": "TARGET_FAILURE, OBSERVER_FAILURE and INDETERMINATE are separate dimensions."
    }
  }
