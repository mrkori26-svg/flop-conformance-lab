    "conformance_drift": {
      "unit": "ratio",
      "numerator": "sources unchanged or conformant",
      "denominator": "sources compared",
      "semantics": "DRIFT is distinct from FAIL and UNKNOWN and retains source revision evidence."
    },
    "failure_classifications": {
      "unit": "classification",
      "numerator": "classified failure observations",
      "denominator": "failure observations",
      "semantics": "TARGET_FAILURE, OBSERVER_FAILURE and INDETERMINATE are separate dimensions."
